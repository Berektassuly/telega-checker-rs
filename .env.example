# Telegram Bot Token (from @BotFather)
TELOXIDE_TOKEN=your_bot_token_here

# SQLite database file path (local development)
# In Docker: overridden by docker-compose.yml → sqlite:/app/data/telega_checker.db?mode=rwc
DATABASE_URL=sqlite:telega_checker.db?mode=rwc

# OK.ru API application key
APPLICATION_KEY=CHKIPMKGDIHBABABA

# Bearer token for the HTTP API (used by Android plugin)
API_BEARER_TOKEN=your_secret_api_token_here

# Port for the HTTP API server (default: 8080)
API_PORT=8080

# Logging level (optional, default: info)
RUST_LOG=info
